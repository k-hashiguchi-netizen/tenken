                </tr>
                <!-- 紙幣小計ラインの強力な太字強調 -->
                <tr class="print-highlight font-black">
                  <td class="text-left font-black text-[13px]">紙幣 小計</td>
                  <td class="text-center font-black font-mono">${(storeVal.b5000 + storeVal.b1000).toLocaleString()} 枚</td>
                  <td class="text-right font-black font-mono text-[13px]">¥${storeVal.paper.toLocaleString()}</td>
                </tr>
                <tr>
                  <td>500円棒金</td>
                  <td class="text-center font-mono">${storeVal.c500.toLocaleString()} 本</td>
                  <td class="text-right font-mono">¥${(storeVal.c500 * 25000).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>100円棒金</td>
                  <td class="text-center font-mono">${storeVal.c100.toLocaleString()} 本</td>
                  <td class="text-right font-mono">¥${(storeVal.c100 * 5000).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>50円棒金</td>
                  <td class="text-center font-mono">${storeVal.c50.toLocaleString()} 本</td>
                  <td class="text-right font-mono">¥${(storeVal.c50 * 2500).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>10円棒金</td>
                  <td class="text-center font-mono">${storeVal.c10.toLocaleString()} 本</td>
                  <td class="text-right font-mono">¥${(storeVal.c10 * 500).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>5円棒金</td>
                  <td class="text-center font-mono">${storeVal.c5.toLocaleString()} 本</td>
                  <td class="text-right font-mono">¥${(storeVal.c5 * 250).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>1円棒金</td>
                  <td class="text-center font-mono">${storeVal.c1.toLocaleString()} 本</td>
                  <td class="text-right font-mono">¥${(storeVal.c1 * 50).toLocaleString()}</td>
                </tr>
                <!-- 硬貨小計ラインの強力な太字強調 -->
                <tr class="print-highlight font-black">
                  <td class="text-left font-black text-[13px]">硬貨 小計</td>
                  <td class="text-center font-black font-mono">${storeCoinsTotal.toLocaleString()} 本</td>
                  <td class="text-right font-black font-mono text-[13px]">¥${storeVal.coin.toLocaleString()}</td>
                </tr>
              </tbody>
              <tfoot>
                <!-- 総合計の太字＆枠線強調 -->
                <tr class="print-grand-total font-black">
                  <td colspan="2" class="text-center font-black text-xs">合計 (紙幣+硬貨)</td>
                  <td class="text-right font-black font-mono text-sm">¥${storeVal.grand.toLocaleString()}</td>
                </tr>
              </tfoot>
            </table>
          </div>
          
          <!-- 【右列：工場事務所のみ】：バラ（枚数）管理・金額合算 -->
          <div>
            <h3 class="bg-emerald-600 text-white p-1 text-xs font-bold mb-2 uppercase text-center rounded">【 工場事務所のみ 】</h3>
            <table class="text-xs text-black">
              <thead>
                <tr class="bg-gray-100">
