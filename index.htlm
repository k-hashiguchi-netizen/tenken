                  <td class="text-right font-mono">¥${(factVal.c1 * 1).toLocaleString()}</td>
                </tr>
                <!-- 硬貨小計ラインの強力な太字強調 -->
                <tr class="print-highlight font-black">
                  <td class="text-left font-black text-[13px]">硬貨 小計</td>
                  <td class="text-center font-black font-mono">${factCoinsTotal.toLocaleString()} 枚</td>
                  <td class="text-right font-black font-mono text-[13px]">¥${factVal.coin.toLocaleString()}</td>
                </tr>
              </tbody>
              <tfoot>
                <!-- 総合計の太字＆枠線強調 -->
                <tr class="print-grand-total font-black">
                  <td colspan="2" class="text-center font-black text-xs">合計 (紙幣+硬貨)</td>
                  <td class="text-right font-black font-mono text-sm">¥${factVal.grand.toLocaleString()}</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <p class="text-[8px] mt-3 font-bold text-black border-t border-gray-300 pt-1">
          ※集計管理規則：店舗分は「棒金（本）」単位、工場分は「バラ（枚）」単位で個別に出力・管理しています。全体の総合合計から工場事務所の金額は完全に除外されています。
        </p>
      </div>`;
    }
  </script>
</body>
</html>
