                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>5,000円札</td>
                  <td class="text-center font-mono">${factVal.b5000.toLocaleString()} 枚</td>
                  <td class="text-right font-mono">¥${(factVal.b5000 * 5000).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>1,000円札</td>
