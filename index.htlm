                <!-- 紙幣小計ラインの強力な太字強調 -->
                <tr class="print-highlight font-black">
                  <td class="text-left font-black text-[13px]">紙幣 小計</td>
                  <td class="text-center font-black font-mono">${(factVal.b5000 + factVal.b1000).toLocaleString()} 枚</td>
