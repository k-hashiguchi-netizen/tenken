<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>両替依頼システム</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .input-number { -moz-appearance: textfield; }
    .input-number::-webkit-outer-spin-button,
    .input-number::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

    /* --- 印刷設定 --- */
    @media print {
      @page {
        size: A4 landscape; /* A4横固定 */
        margin: 5mm;
      }
      body { background: white !important; padding: 0 !important; color: black !important; }
      .no-print { display: none !important; }
      .print-only { display: block !important; }
      
      #print-area { width: 100%; display: block !important; }

      /* 一括印刷：2枚並び設定 */
      .bulk-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8mm;
        width: 100%;
      }

      /* 店舗用内訳票レイアウト */
      .print-section {
        width: 135mm;
        margin: 0;
        padding: 5mm;
        border: 1px solid #ccc;
        page-break-inside: avoid;
      }

      /* 本日集計表：店舗と工場事務所をA4横の左右に分けるために、幅を280mmに拡張 */
      .summary-print-section {
        width: 280mm;
        margin: 0 auto; 
        padding: 5mm;
        border: 2px solid black;
        color: black !important;
        page-break-inside: avoid;
      }

      /* 左右並び用のグリッドレイアウト */
      .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8mm;
      }

      .page-break { page-break-after: always; }
      table { border-collapse: collapse; border: 2px solid black !important; width: 100%; }
      th, td { border-color: black !important; color: black !important; border-width: 1px !important; padding: 6px !important; color: black !important; }
      
      /* --- 印刷時のみ適用される小計・合計の強調用スタイル --- */
      .print-highlight {
        font-weight: 900 !important;
        background-color: #f1f5f9 !important; /* 薄いグレー背景 */
        border-top: 2px solid black !important;
        border-bottom: 2px solid black !important;
      }
      .print-highlight td {
        font-weight: 900 !important;
        font-size: 14px !important;
      }
      .print-grand-total {
        font-weight: 900 !important;
        background-color: #e2e8f0 !important; /* やや濃いめのグレー背景 */
        border: 3px solid black !important; /* 太枠で囲む */
      }
      .print-grand-total td {
        font-weight: 900 !important;
        font-size: 18px !important;
        border-top: 3px double black !important; /* 二重下線 */
        border-bottom: 3px double black !important;
      }
      .print-bold { font-weight: 900 !important; }
    }
    .print-only { display: none; }
  </style>
</head>
<body class="bg-slate-100 min-h-screen pb-10 font-sans text-slate-900 text-[16px]">

  <nav class="bg-slate-800 text-white p-4 shadow-lg mb-6 no-print">
    <div class="container mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold flex items-center">
        <span class="mr-2 text-yellow-400 font-bold">¥</span> 両替依頼アプリ
      </h1>
      <div id="nav-buttons" class="flex space-x-2">
        <button id="nav-store" onclick="switchView('store')" class="px-4 py-2 bg-blue-600 rounded-lg font-bold shadow-md text-white border border-blue-400">店舗入力</button>
        <button id="nav-admin" onclick="loadAdminData()" class="px-4 py-2 bg-slate-700 rounded-lg font-bold text-slate-300 border border-slate-600">本店事務所</button>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 max-w-6xl no-print">
    
    <!-- 店舗入力ビュー -->
    <div id="store-view" class="view-content">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 text-black">
        <div class="lg:col-span-7 bg-white rounded-2xl shadow-xl p-6 border-t-8 border-blue-600">
          <div class="flex justify-between items-start mb-6 border-b pb-4">
            <div>
              <h2 class="text-2xl font-black text-slate-800 tracking-tight text-black">両替依頼入力</h2>
              <p id="store-instruction" class="text-xs text-slate-500 mt-1 font-bold">棒金の本数（1本50枚）で入力してください</p>
            </div>
            <div class="text-right">
              <span class="text-xs text-slate-400 block font-bold">依頼日</span>
              <span id="today-date" class="text-lg font-bold text-blue-600 font-mono tracking-tighter">----/--/--</span>
            </div>
          </div>
          
          <form id="exchangeForm" oninput="calculateTotal()">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 shadow-sm text-center text-black">
                <label class="block text-xs font-black text-blue-700 mb-1 uppercase tracking-wider">店舗名</label>
                <div id="storeNameDisplay" class="text-2xl font-black text-slate-800 py-2 font-sans">特定中...</div>
                <input type="hidden" id="storeName" value="">
              </div>
              <!-- プルダウン横の不要なボタンを削除して、表示幅を広げスッキリさせました -->
              <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 shadow-sm text-center text-black flex flex-col justify-between">
                <label class="block text-xs font-black text-blue-700 mb-1 uppercase tracking-wider font-bold">担当者名</label>
                <div class="mt-1">
                  <select id="staffName" required class="block w-full rounded-lg border-slate-300 p-2.5 bg-white border-2 text-base font-bold focus:ring-4 focus:ring-blue-200 outline-none">
                    <option value="">担当者を選択...</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- 👤 担当者マスタ管理（店舗用の折りたたみトグルパネルをアコーディオン型で新設） -->
            <div class="mb-6 bg-slate-50 border border-slate-200 rounded-xl p-3.5 transition-all">
              <button type="button" onclick="toggleStoreStaffManager()" class="w-full flex justify-between items-center font-bold text-slate-700 outline-none text-xs">
                <span class="flex items-center gap-1.5 text-blue-700">👤 自店舗の担当者を登録・削除する</span>
                <span id="store-staff-toggle-icon" class="text-[10px]">▼ 開く</span>
              </button>
              <div id="store-staff-manager-content" class="hidden mt-3.5 pt-3.5 border-t border-slate-200">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <!-- 新規登録 -->
                  <div>
                    <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-wider mb-2 text-left">新しい担当者の追加登録</h4>
                    <div class="flex gap-2">
                      <input type="text" id="storeNewStaffInput" class="flex-1 p-2 border-2 border-slate-200 rounded-lg font-bold text-xs outline-none focus:border-blue-500 bg-white" placeholder="名前を入力">
                      <button type="button" onclick="addStaffFromStore()" class="bg-blue-600 hover:bg-blue-500 text-white font-black px-4 py-2 rounded-lg text-xs transition-all active:scale-95">新規登録</button>
                    </div>
                  </div>
                  <!-- 登録中一覧と削除 -->
                  <div>
                    <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-wider mb-2 text-left">登録中の担当者一覧</h4>
                    <div id="store-staff-list" class="space-y-1 max-h-24 overflow-y-auto border border-slate-200 rounded-lg p-1.5 bg-white shadow-inner">
                      <p class="text-[10px] text-slate-400 font-bold italic text-center py-2">読み込み中...</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="space-y-4">
              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 shadow-inner">
                <h3 class="font-bold text-slate-700 mb-3 text-sm flex items-center text-black"><span class="bg-slate-700 text-white w-5 h-5 rounded-full inline-flex items-center justify-center text-xs mr-2">1</span>紙幣</h3>
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[11px] font-bold text-slate-400 block">5,000円札</label><div class="flex items-center"><input type="number" id="bill5000" min="0" class="block w-full p-1 text-right text-xl font-black focus:text-blue-600 outline-none border-none" placeholder="0"><span class="ml-1 text-xs">枚</span></div></div>
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[11px] font-bold text-slate-400 block">1,000円札</label><div class="flex items-center"><input type="number" id="bill1000" min="0" class="block w-full p-1 text-right text-xl font-black focus:text-blue-600 outline-none border-none" placeholder="0"><span class="ml-1 text-xs">枚</span></div></div>
                </div>
              </div>
              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 shadow-inner">
                <h3 id="coin-section-title" class="font-bold text-slate-700 mb-3 text-sm flex items-center text-black"><span class="bg-slate-700 text-white w-5 h-5 rounded-full inline-flex items-center justify-center text-xs mr-2">2</span>棒金</h3>
                <div class="grid grid-cols-3 gap-2">
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[9px] font-bold text-slate-400 block">500円</label><input type="number" id="coin500" min="0" class="input-number block w-full text-right text-lg font-black border-none focus:text-emerald-600 outline-none" placeholder="0"></div>
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[9px] font-bold text-slate-400 block">100円</label><input type="number" id="coin100" min="0" class="input-number block w-full text-right text-lg font-black border-none focus:text-emerald-600 outline-none" placeholder="0"></div>
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[9px] font-bold text-slate-400 block">50円</label><input type="number" id="coin50" min="0" class="input-number block w-full text-right text-lg font-black border-none focus:text-emerald-600 outline-none" placeholder="0"></div>
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[9px] font-bold text-slate-400 block">10円</label><input type="number" id="coin10" min="0" class="input-number block w-full text-right text-lg font-black border-none focus:text-emerald-600 outline-none" placeholder="0"></div>
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[9px] font-bold text-slate-400 block">5円</label><input type="number" id="coin5" min="0" class="input-number block w-full text-right text-lg font-black border-none focus:text-emerald-600 outline-none" placeholder="0"></div>
                  <div class="bg-white p-2 rounded-lg border shadow-sm text-center"><label class="text-[9px] font-bold text-slate-400 block">1円</label><input type="number" id="coin1" min="0" class="input-number block w-full text-right text-lg font-black border-none focus:text-emerald-600 outline-none" placeholder="0"></div>
                </div>
              </div>
            </div>
            
            <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-3">
              <!-- 計算表示エリア -->
              <div class="md:col-span-3 p-4 bg-slate-900 rounded-xl text-white shadow-lg flex flex-col justify-between">
                
                <!-- ① 通常店用の合計表示 (デフォルト) -->
                <div id="store-simple-total" class="flex justify-between items-center px-2 font-mono">
                  <span id="total-title-label" class="text-slate-400 font-bold text-xs">合計金額</span>
                  <span class="text-3xl font-black text-yellow-400 tracking-tighter">¥ <span id="display-total">0</span></span>
                </div>

                <!-- ② 工場事務所用の合計表示 (動的切替) -->
                <div id="factory-detailed-total" class="hidden space-y-1.5 px-2 font-sans text-sm font-bold border-b border-slate-700 pb-2 mb-2">
                  <div class="flex justify-between text-slate-300"><span>工場 紙幣計:</span><span>¥ <span id="display-factory-paper">0</span></span></div>
                  <div class="flex justify-between text-slate-300"><span>工場 硬貨計:</span><span>¥ <span id="display-factory-coin">0</span></span></div>
                  <div class="flex justify-between text-yellow-400 text-lg font-black pt-1 border-t border-dashed border-slate-700">
                    <span>紙幣硬貨 合計:</span>
                    <span>¥ <span id="display-factory-grand">0</span></span>
                  </div>
                </div>

                <button type="button" onclick="submitForm(false)" class="w-full mt-2 py-3 bg-blue-600 text-white font-black rounded-lg hover:bg-blue-500 text-lg transition-all active:scale-95">依頼を送信</button>
              </div>
              <button type="button" onclick="submitForm(true)" class="md:col-span-1 p-3 bg-slate-200 text-slate-600 font-black rounded-xl hover:bg-red-100 transition-all text-xs border-2 border-slate-300">今日は依頼なし</button>
            </div>
          </form>
        </div>

        <!-- 右側：確認・カレンダー検索 -->
        <div class="lg:col-span-5 text-black font-sans">
          <div id="store-sent-card" class="bg-white rounded-2xl shadow-xl border-2 border-slate-200 p-5 sticky top-4 min-h-[550px] flex flex-col">
            <div class="mb-4 p-3 bg-slate-50 rounded-xl border-2 border-slate-100 text-black">
              <label class="block text-[10px] font-black text-slate-400 mb-1 uppercase tracking-widest text-center">カレンダー履歴検索</label>
              <div class="flex gap-2">
                <input type="date" id="searchDate" class="flex-1 p-2 border-2 border-slate-200 rounded-lg font-bold text-slate-800 outline-none focus:border-blue-500 text-sm">
                <button onclick="fetchHistoryByDate()" class="bg-slate-800 text-white px-3 py-2 rounded-lg font-bold text-sm shadow-md">検索</button>
              </div>
            </div>
            <div class="flex items-center justify-between border-b-2 border-slate-100 pb-2 mb-4">
              <span id="display-status-type" class="text-lg font-black text-slate-700">送信済み内容</span>
              <span id="store-status-badge" class="text-[9px] bg-slate-200 px-2 py-0.5 rounded-full text-slate-500 font-black">未確認</span>
            </div>
            <div id="sent-store-display" class="py-2 px-3 bg-slate-100 rounded-lg mb-4 text-center border font-bold"><span id="sent-store-name" class="text-base font-black text-slate-700">---</span></div>
            <div id="store-sent-content" class="text-slate-400 text-center py-20 italic text-sm leading-relaxed flex-1 flex items-center justify-center bg-slate-50 rounded-xl border-2 border-dashed border-slate-200 px-4 font-bold text-black">データがありません。</div>
            <div id="store-sent-details" class="hidden flex-1 flex flex-col text-black">
              
              <!-- 上部金額サマリーボックス -->
              <div id="sent-summary-box" class="flex flex-col mb-4 bg-blue-600 p-4 rounded-xl shadow-md text-white font-bold">
                <div class="flex justify-between items-center text-xs opacity-80 border-b border-blue-400 pb-1.5 mb-1.5">
                  <span>送信時間: <span id="sent-time" class="font-mono font-bold">--:--</span></span>
                  <span id="sent-staff-name-display" class="font-bold">担当：---</span>
                </div>
                <!-- 一般店舗用合計表示 -->
                <div id="sent-store-normal-sum" class="flex justify-between items-end">
                  <span class="text-[10px] uppercase font-bold">総合合計 (紙幣+硬貨)</span>
                  <span id="sent-total" class="text-2xl font-black font-mono text-yellow-300">¥ 0</span>
                </div>
                <!-- 工場事務所用合計表示 -->
                <div id="sent-factory-detailed-sum" class="hidden space-y-1 text-sm">
                  <div class="flex justify-between"><span>工場 紙幣計:</span><span id="sent-factory-paper-val">¥ 0</span></div>
                  <div class="flex justify-between"><span>工場 硬貨計:</span><span id="sent-factory-coin-val">¥ 0</span></div>
                  <div class="flex justify-between text-yellow-300 font-black text-base border-t border-dashed border-blue-400 pt-1 mt-1">
                    <span>紙幣硬貨合計:</span><span id="sent-factory-grand-val">¥ 0</span>
                  </div>
                </div>
              </div>

              <div id="sent-table-container" class="bg-white rounded-lg border overflow-hidden flex-1 shadow-inner">
                <table class="w-full text-xs border-collapse font-bold">
                  <thead><tr class="bg-slate-50 text-slate-500 font-bold text-[9px] border-b"><th class="py-1.5 pl-4 text-left">金種</th><th class="py-1.5 text-center">数量</th><th id="sent-header-amount" class="py-1.5 pr-4 text-right">金額</th></tr></thead>
                  <tbody id="sent-breakdown-body" class="text-slate-700 font-bold text-center font-mono"></tbody>
                </table>
              </div>
              
              <button id="btn-print-self" class="mt-4 w-full py-3 bg-slate-800 text-white rounded-lg text-base font-black shadow-lg hover:bg-slate-700 transition active:scale-95 flex items-center justify-center gap-2"><span>🖨️</span> 内訳票を印刷</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 本店事務所ビュー -->
    <div id="admin-view" class="view-content hidden text-black">
      <div class="bg-white rounded-2xl shadow-xl p-6 border-t-8 border-slate-700">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-black text-slate-800 border-b-4 border-blue-500 pb-1 uppercase tracking-tight text-black">本店事務所 集計パネル</h2>
          <div class="flex gap-2">
            <button onclick="loadAdminData()" class="px-3 py-2 bg-slate-100 text-slate-700 rounded-lg font-bold border text-xs">🔄 更新</button>
            <button id="btn-bulk-print" onclick="bulkPrintSlips()" class="px-3 py-2 bg-slate-800 text-white rounded-lg font-black shadow-md text-xs disabled:opacity-30">🖨️ 各店一括</button>
            <button id="btn-summary-print" onclick="printSummary()" class="px-3 py-2 bg-blue-600 text-white rounded-lg font-black shadow-md text-xs disabled:opacity-30">📊 本日集計</button>
          </div>
        </div>

        <!-- 👤 担当者マスタ管理（折りたたみパネル式ツール） -->
        <div class="mb-8 bg-slate-50 border border-slate-200 rounded-2xl p-4 transition-all">
          <button onclick="toggleStaffManager()" class="w-full flex justify-between items-center font-black text-slate-700 outline-none text-sm">
            <span class="flex items-center gap-2 text-blue-700">👤 担当者マスタの登録・削除 管理ツール</span>
            <span id="staff-toggle-icon" class="text-xs">▼ 開く</span>
          </button>
          <div id="staff-manager-content" class="hidden mt-4 pt-4 border-t border-slate-200">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- 左側：店舗選択と新規登録 -->
              <div class="bg-white p-4 rounded-xl border shadow-sm">
                <h4 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-3">新しい担当者の登録</h4>
                <div class="space-y-3">
                  <div>
                    <label class="block text-[11px] font-bold text-slate-500 mb-1">登録対象の店舗</label>
                    <select id="adminStaffStoreSelect" class="w-full p-2 border-2 border-slate-200 rounded-lg font-bold text-xs outline-none focus:border-blue-500 bg-white" onchange="loadStaffListForAdmin()"></select>
                  </div>
                  <div class="flex gap-2">
                    <input type="text" id="newStaffInput" class="flex-1 p-2 border-2 border-slate-200 rounded-lg font-bold text-xs outline-none focus:border-blue-500" placeholder="氏名を入力してください">
                    <button onclick="addStaffMaster()" class="bg-blue-600 hover:bg-blue-500 text-white font-black px-4 py-2 rounded-lg text-xs transition-all active:scale-95">新規登録</button>
                  </div>
                </div>
              </div>
              <!-- 右側：一覧と削除 -->
              <div class="bg-white p-4 rounded-xl border shadow-sm">
                <h4 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-2">選択中店舗の登録担当者一覧</h4>
                <div id="staff-master-list" class="space-y-1.5 max-h-36 overflow-y-auto border border-slate-200 rounded-lg p-2 bg-slate-50 shadow-inner">
                  <p class="text-xs text-slate-400 font-bold italic text-center py-6">上の店舗を選択してください</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="admin-store-status-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-8 text-center font-bold text-black"></div>
        
        <!-- 【工場事務所・店舗の集計対比カード】 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 font-bold">
          <!-- ① 店舗合計 (工場除く) -->
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-200">
            <p class="text-[10px] font-black text-blue-600 mb-3 uppercase tracking-wider">店舗合計 (工場事務所除く)</p>
            <div class="space-y-1 mb-3 text-slate-700 text-sm">
              <div class="flex justify-between"><span>総合合計 (紙幣+硬貨):</span><span id="sum-store-bills" class="font-black text-blue-900">¥0</span></div>
              <div class="flex justify-between"><span>硬貨総本数:</span><span id="sum-store-coins">0本</span></div>
              <div class="flex justify-between"><span>提出店舗数:</span><span id="sum-store-count">0 / 0 店</span></div>
            </div>
            <div class="border-t border-blue-200 pt-3 flex justify-between items-center font-mono text-slate-400 text-[10px]">
              <span>紙幣内訳</span>
              <span>5k札: <span id="sum-store-5000">0</span>枚 / 1k札: <span id="sum-store-1000">0</span>枚</span>
            </div>
          </div>
          
          <!-- ② 工場事務所のみ (紙幣・硬貨・総合計を個別表示) -->
          <div class="bg-emerald-50 p-5 rounded-2xl border border-emerald-200 text-black">
            <p class="text-[10px] font-black text-emerald-600 mb-3 uppercase tracking-wider">工場事務所のみ</p>
            <div class="space-y-1 mb-3 text-slate-700 text-sm">
              <div class="flex justify-between"><span>工場紙幣計:</span><span id="sum-factory-bills" class="font-black text-emerald-950">¥0</span></div>
              <div class="flex justify-between"><span>工場硬貨計:</span><span id="sum-factory-coin-amt" class="font-black text-emerald-950">¥0</span></div>
              <div class="flex justify-between border-t border-emerald-300 pt-1"><span>紙幣硬貨合計:</span><span id="sum-factory-total-amt" class="font-black text-emerald-900">¥0</span></div>
              <div class="flex justify-between"><span>硬貨総枚数:</span><span id="sum-factory-coins">0枚</span></div>
              <div class="flex justify-between"><span>提出状況:</span><span id="sum-factory-status" class="bg-slate-200 px-2 py-0.5 rounded text-xs font-bold text-slate-600">未提出</span></div>
            </div>
            <div class="border-t border-emerald-200 pt-3 flex justify-between items-center font-mono text-slate-400 text-[10px]">
              <span>紙幣内訳</span>
              <span>5k札: <span id="sum-factory-5000">0</span>枚 / 1k札: <span id="sum-factory-1000">0</span>枚</span>
            </div>
          </div>
          
          <!-- ③ 総合合計 (工場事務所を完全に排除した店舗分のみのカード) -->
          <div id="grand-total-box" class="bg-slate-900 p-5 rounded-2xl shadow-xl flex flex-col justify-center text-white font-mono font-bold transition-all">
            <p class="text-[10px] text-slate-400 mb-1 uppercase tracking-wider">総合合計 (工場事務所除く)</p>
            <p id="sum-grand-total" class="text-4xl font-black text-yellow-400 tracking-tighter">¥ 0</p>
            <div class="mt-4 pt-3 border-t border-slate-700 flex justify-between items-center text-[10px]">
              <span>店舗硬貨量</span>
              <span id="sum-total-coins-count" class="bg-slate-700 px-3 py-0.5 rounded-full font-black text-white text-xs font-mono">店舗: 0本</span>
            </div>
          </div>
        </div>
        
        <div class="max-w-full overflow-x-auto rounded-xl border bg-white shadow-inner">
          <table class="w-full text-[10px] text-left text-slate-600 border-collapse font-bold">
            <thead class="bg-slate-100 font-black text-slate-500 border-b-2 text-center text-black">
              <tr id="admin-head"></tr>
            </thead>
            <tbody id="admin-body" class="font-mono text-black font-bold"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div id="print-area" class="print-only bg-white text-black"></div>

  <!-- ℹ️ カスタム警告モーダル (ネイティブalertによるフリーズを完全に排除) -->
  <div id="customModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden no-print">
    <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-sm w-full mx-4 border-t-8 border-blue-600">
      <div class="text-center">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 mb-4">
          <span class="text-blue-600 font-bold text-xl">ℹ</span>
        </div>
        <h3 class="text-lg font-bold text-slate-800 mb-2">システムメッセージ</h3>
        <p id="customModalMessage" class="text-sm text-slate-600 font-medium whitespace-pre-line leading-relaxed mb-6"></p>
        <button onclick="closeModal()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-black rounded-lg transition-all active:scale-95 shadow-md">確認</button>
      </div>
    </div>
  </div>

  <script>
    const initialStore = "<?= store ?>"; 
    let masterStores = [];
    let globalDataRows = [];
    let todayRecords = [];
    
    // 印刷用のデータ：店舗は本数および金額合算、工場は枚数かつ金額別
    let currentSummaryTotals = { 
      store: { b5000:0, b1000:0, c500:0, c100:0, c50:0, c10:0, c5:0, c1:0, grand:0, paper:0, coin:0 },
      factory: { b5000:0, b1000:0, c500:0, c100:0, c50:0, c10:0, c5:0, c1:0, grand:0, paper:0, coin:0 },
      grand: 0
    };

    /* --- カスタムモーダル表示関数 --- */
    function showModal(msg) {
      const modal = document.getElementById('customModal');
      const msgEl = document.getElementById('customModalMessage');
      if (modal && msgEl) {
        msgEl.innerText = msg;
        modal.classList.remove('hidden');
      } else {
        alert(msg);
      }
    }

    function closeModal() {
      const modal = document.getElementById('customModal');
      if (modal) {
        modal.classList.add('hidden');
      }
    }

    const isSameDate = (d1, d2) => {
      if (!d1 || !d2) return false;
      const date1 = new Date(d1);
      const date2 = new Date(d2);
      return date1.getFullYear() === date2.getFullYear() &&
             date1.getMonth() === date2.getMonth() &&
             date1.getDate() === date2.getDate();
    };

    const isTodayRecord = (dateVal) => isSameDate(dateVal, new Date());

    const cleanNum = (val) => {
      if (typeof val === 'number') return isNaN(val) ? 0 : Math.max(0, val);
      if (!val) return 0;
      return Math.max(0, Number(String(val).replace(/[^0-9.]+/g, "")) || 0);
    };

    const setInnerTextSafe = (id, text) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    window.onload = function() {
      const now = new Date();
      setInnerTextSafe('today-date', now.toLocaleDateString('ja-JP'));
      const searchDateEl = document.getElementById('searchDate');
      if (searchDateEl) searchDateEl.value = now.toISOString().split('T')[0];

      const navAdmin = document.getElementById('nav-admin');
      const navStore = document.getElementById('nav-store');
      const nameDisp = document.getElementById('storeNameDisplay');
      const hiddenInput = document.getElementById('storeName');

      const isFactoryUser = (initialStore === "工場事務所");

      // 工場事務所ログイン時のUI先行最適化
      if (isFactoryUser) {
        const inst = document.getElementById('store-instruction');
        if (inst) inst.innerText = "枚数（バラ単位）で入力してください。";
        const coinTitle = document.getElementById('coin-section-title');
        if (coinTitle) coinTitle.innerHTML = `<span class="bg-slate-700 text-white w-5 h-5 rounded-full inline-flex items-center justify-center text-xs mr-2">2</span>硬貨 (枚数)`;
        
        // 金額欄の工場用詳細表示をオンにする
        const simpleTotal = document.getElementById('store-simple-total');
        const factoryTotal = document.getElementById('factory-detailed-total');
        if (simpleTotal) simpleTotal.classList.add('hidden');
        if (factoryTotal) factoryTotal.classList.remove('hidden');
      }

      if (initialStore && initialStore !== "undefined" && initialStore !== "") {
        if (navAdmin) navAdmin.style.display = 'none';
        if (nameDisp) nameDisp.innerText = initialStore;
        if (hiddenInput) hiddenInput.value = initialStore;
        switchView('store');
      } else {
        if (navStore) navStore.style.display = 'none';
        if (nameDisp) nameDisp.innerText = "管理者モード";
        switchView('admin');
      }

      // 店舗リストの取得
      google.script.run
        .withSuccessHandler(function(stores) {
          masterStores = stores || [];
          if (initialStore && masterStores.includes(initialStore)) {
            fetchCurrentStoreRequest();
          } else {
            loadAdminData();
          }
          
          // 本店事務所用の店舗プルダウンをロード
          const adminStoreSelect = document.getElementById('adminStaffStoreSelect');
          if (adminStoreSelect) {
            adminStoreSelect.innerHTML = masterStores.map(name => `<option value="${name}">${name}</option>`).join('');
            loadStaffListForAdmin(); // 初期店舗のマスタ読み込み
          }
        })
        .getStoreList();

      // 初期起動時に担当者マスタを取得してプルダウンにロードする
      refreshStaffDropdown();
    };

    /**
     * 担当者プルダウンを再読み込みして表示を更新する
     */
    function refreshStaffDropdown() {
      const storeName = initialStore || document.getElementById('storeName').value;
      if (!storeName) return;
      
      google.script.run
        .withSuccessHandler(function(staffList) {
          const select = document.getElementById('staffName');
          if (!select) return;
          
          // 現在選択されている値を一時保持
          const currentVal = select.value;
          
          // 初期化
          select.innerHTML = '<option value="">担当者を選択...</option>';
          if (staffList && staffList.length > 0) {
            staffList.forEach(name => {
              const opt = document.createElement('option');
              opt.value = name;
              opt.innerText = name;
              select.appendChild(opt);
            });
          }
          // 選択状態を復元
          if (staffList && staffList.includes(currentVal)) {
            select.value = currentVal;
          }
        })
        .getStaffList(storeName);
    }

    /**
     * 店舗用：担当者マスタ管理トグルの開閉コントロール
     */
    function toggleStoreStaffManager() {
      const content = document.getElementById('store-staff-manager-content');
      const icon = document.getElementById('store-staff-toggle-icon');
      if (!content) return;
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        if (icon) icon.innerText = '▲ 閉じる';
        loadStaffListForStore();
      } else {
        content.classList.add('hidden');
        if (icon) icon.innerText = '▼ 開く';
      }
    }

    /**
     * 店舗画面用の担当者マスタ一覧の再読み込み
     */
    function loadStaffListForStore() {
      const storeName = initialStore || document.getElementById('storeName').value;
      if (!storeName) return;
      const listContainer = document.getElementById('store-staff-list');
      if (!listContainer) return;
      
      listContainer.innerHTML = '<p class="text-[10px] text-slate-400 font-bold italic text-center py-2">マスタを読み込み中...</p>';
      
      google.script.run
        .withSuccessHandler(function(staffList) {
          if (!staffList || staffList.length === 0) {
            listContainer.innerHTML = '<p class="text-[10px] text-slate-400 font-bold italic text-center py-2">登録されている担当者がいません。</p>';
            return;
          }
          listContainer.innerHTML = staffList.map(name => `
            <div class="flex justify-between items-center bg-slate-50 p-1 border rounded font-bold text-[11px] text-slate-800">
              <span>👤 ${name}</span>
              <!-- 2段階確定クリック削除ボタン (ネイティブconfirmを完全排除) -->
              <button type="button" 
                      data-staff="${name}" 
                      onclick="confirmDeleteStaffStore(this)" 
                      class="text-red-500 hover:text-red-700 px-1.5 py-0.5 rounded hover:bg-red-50 transition-all font-sans text-[10px] font-bold">削除</button>
            </div>
          `).join('');
        })
        .getStaffList(storeName);
    }

    /**
     * 店舗画面用：担当者削除 of 2段階クリック確認
     */
    function confirmDeleteStaffStore(btn) {
      const staffName = btn.getAttribute('data-staff');
      if (btn.innerText === "削除") {
        // 全ボタンを一旦元に戻す
        document.querySelectorAll('#store-staff-list button').forEach(b => {
          b.innerText = "削除";
          b.className = "text-red-500 hover:text-red-700 px-1.5 py-0.5 rounded hover:bg-red-50 transition-all font-sans text-[10px] font-bold";
        });
        // 選択されたボタンを確定モードにする
        btn.innerText = "確定?";
        btn.className = "text-white bg-red-600 px-1.5 py-0.5 rounded transition-all font-sans text-[10px] font-bold animate-pulse";
      } else {
        // 確定されたため、実際の削除を非同期で実行
        deleteStaffFromStore(staffName);
      }
    }

    /**
     * 店舗画面からの新規担当者マスタ登録処理
     */
    function addStaffFromStore() {
      const storeName = initialStore || document.getElementById('storeName').value;
      const input = document.getElementById('storeNewStaffInput');
      const name = input.value.trim();
      if (!name) { showModal('登録する担当者の名前を入力してください。'); return; }
      
      input.disabled = true;
      google.script.run
        .withSuccessHandler(function(res) {
          input.disabled = false;
          if (res && res.success) {
            input.value = '';
            showModal('新しい担当者を追加登録しました。');
            loadStaffListForStore();  // 店舗用一覧を更新
            refreshStaffDropdown();   // プルダウンを更新
          } else {
            showModal('登録エラー: ' + (res.error || '不明なエラー'));
          }
        })
        .withFailureHandler(function(err) {
          input.disabled = false;
          showModal('通信失敗: ' + err.toString());
        })
        .addStaff(storeName, name);
    }

    /**
     * 店舗画面からの登録済み担当者の削除処理
     */
    function deleteStaffFromStore(name) {
      const storeName = initialStore || document.getElementById('storeName').value;
      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.success) {
            showModal('担当者マスタから削除しました。');
            loadStaffListForStore();  // 店舗用一覧を更新
            refreshStaffDropdown();   // プルダウンを更新
          } else {
            showModal('削除エラー: ' + (res.error || '不明なエラー'));
          }
        })
        .withFailureHandler(function(err) {
          showModal('通信失敗: ' + err.toString());
        })
        .deleteStaff(storeName, name);
    }

    /**
     * 本店管理画面：担当者マスタ管理トグルの開閉コントロール
     */
    function toggleStaffManager() {
      const content = document.getElementById('staff-manager-content');
      const icon = document.getElementById('staff-toggle-icon');
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        icon.innerText = '▲ 閉じる';
        loadStaffListForAdmin(); // 開いた時にリストを最新化
      } else {
        content.classList.add('hidden');
        icon.innerText = '▼ 開く';
      }
    }

    /**
     * 本店管理画面用の担当者マスタ一覧の再読み込み
     */
    function loadStaffListForAdmin() {
      const storeSelect = document.getElementById('adminStaffStoreSelect');
      if (!storeSelect) return;
      const storeName = storeSelect.value;
      if (!storeName) return;

      const listContainer = document.getElementById('staff-master-list');
      if (!listContainer) return;
      
      listContainer.innerHTML = '<p class="text-xs text-slate-400 font-bold italic text-center py-6">マスタを読み込み中...</p>';
      
      google.script.run
        .withSuccessHandler(function(staffList) {
          if (!staffList || staffList.length === 0) {
            listContainer.innerHTML = '<p class="text-xs text-slate-400 font-bold italic text-center py-6">登録されている担当者がいません。</p>';
            return;
          }
          listContainer.innerHTML = staffList.map(name => `
            <div class="flex justify-between items-center bg-white p-2 border rounded-lg shadow-sm font-bold text-xs text-slate-800">
              <span>👤 ${name}</span>
              <!-- 2段階確定クリック削除ボタン (ネイティブconfirmを完全排除) -->
              <button data-staff="${name}" onclick="confirmDeleteStaffAdmin(this)" class="text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded transition-all font-bold">削除</button>
            </div>
          `).join('');
        })
        .getStaffList(storeName);
    }

    /**
     * 事務所画面用：担当者削除の2段階クリック確認
     */
    function confirmDeleteStaffAdmin(btn) {
      const staffName = btn.getAttribute('data-staff');
      if (btn.innerText === "削除") {
        document.querySelectorAll('#staff-master-list button').forEach(b => {
          b.innerText = "削除";
          b.className = "text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded transition-all font-bold";
        });
        btn.innerText = "確定?";
        btn.className = "text-white bg-red-600 px-2 py-1 rounded transition-all font-bold animate-pulse";
      } else {
        deleteStaffMaster(staffName);
      }
    }

    /**
     * 本店管理画面からの新規担当者のマスタ登録処理
     */
    function addStaffMaster() {
      const storeSelect = document.getElementById('adminStaffStoreSelect');
      const input = document.getElementById('newStaffInput');
      if (!storeSelect || !input) return;
      
      const storeName = storeSelect.value;
      const name = input.value.trim();
      if (!storeName) { showModal('登録先の店舗を選択してください。'); return; }
      if (!name) { showModal('登録する担当者の名前を入力してください。'); return; }
      
      input.disabled = true;
      google.script.run
        .withSuccessHandler(function(res) {
          input.disabled = false;
          if (res && res.success) {
            input.value = '';
            showModal('新しい担当者マスタを追加登録しました。');
            loadStaffListForAdmin(); // 管理側一覧を更新
            refreshStaffDropdown();  // 店舗側プルダウンを更新
          } else {
            showModal('登録エラー: ' + (res.error || '不明なエラー'));
          }
        })
        .withFailureHandler(function(err) {
          input.disabled = false;
          showModal('通信失敗: ' + err.toString());
        })
        .addStaff(storeName, name);
    }

    /**
     * 本店管理画面からの登録済み担当者の削除処理
     */
    function deleteStaffMaster(name) {
      const storeSelect = document.getElementById('adminStaffStoreSelect');
      if (!storeSelect) return;
      const storeName = storeSelect.value;
      if (!storeName) return;
      
      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.success) {
            showModal('担当者マスタを削除しました。');
            loadStaffListForAdmin(); // 管理側一覧を更新
            refreshStaffDropdown();  // 店舗側プルダウンを更新
          } else {
            showModal('削除エラー: ' + (res.error || '不明なエラー'));
          }
        })
        .withFailureHandler(function(err) {
          showModal('通信失敗: ' + err.toString());
        })
        .deleteStaff(storeName, name);
    }

    /**
     * 合計計算：店舗入力用
     * ※ログイン中の店舗名が「工場事務所」なら合計は紙幣＋硬貨の合計とし、詳細を内訳に表示
     * それ以外（通常店）なら紙幣＋硬貨(棒金レート換算)を総合計とします。
     */
    function calculateTotal() {
      try {
        const storeName = document.getElementById('storeName').value;
        const isFactory = storeName === "工場事務所";
        
        const getVal = (id) => { const el = document.getElementById(id); return el ? cleanNum(el.value) : 0; };
        const b5000 = getVal('bill5000') * 5000;
        const b1000 = getVal('bill1000') * 1000;
        const subBills = b5000 + b1000;

        // 工場は1枚単位、一般店舗は1本（50枚）単位の金額換算
        const coinVal500 = isFactory ? (getVal('coin500') * 500) : (getVal('coin500') * 25000);
        const coinVal100 = isFactory ? (getVal('coin100') * 100) : (getVal('coin100') * 5000);
        const coinVal50  = isFactory ? (getVal('coin50') * 50)  : (getVal('coin50') * 2500);
        const coinVal10  = isFactory ? (getVal('coin10') * 10)  : (getVal('coin10') * 500);
        const coinVal5   = isFactory ? (getVal('coin5') * 5)    : (getVal('coin5') * 250);
        const coinVal1   = isFactory ? (getVal('coin1') * 1)    : (getVal('coin1') * 50);

        const subCoins = coinVal500 + coinVal100 + coinVal50 + coinVal10 + coinVal5 + coinVal1;
        
        const titleLabel = document.getElementById('total-title-label');
        if (titleLabel) {
          titleLabel.innerText = "総合合計額 (紙幣+硬貨)";
        }

        if (isFactory) {
          // 工場事務所の場合は、専用の3段合計欄にリアルタイムに計算値を反映させる
          setInnerTextSafe('display-factory-paper', subBills.toLocaleString());
          setInnerTextSafe('display-factory-coin', subCoins.toLocaleString());
          setInnerTextSafe('display-factory-grand', (subBills + subCoins).toLocaleString());
        } else {
          // 一般店舗は総合計のみ表示
          setInnerTextSafe('display-total', (subBills + subCoins).toLocaleString());
        }

        return subBills + subCoins;
      } catch (e) { return 0; }
    }

    function switchView(view) {
      document.querySelectorAll('.view-content').forEach(v => v.classList.add('hidden'));
      const target = document.getElementById(view + '-view');
      if (target) target.classList.remove('hidden');
      const ns = document.getElementById('nav-store');
      const na = document.getElementById('nav-admin');
      if (view === 'store') {
        if (ns) ns.className = "px-4 py-2 bg-blue-600 rounded-lg font-bold shadow-md text-white border border-blue-400 font-sans";
        if (na) na.className = "px-4 py-2 bg-slate-700 rounded-lg font-bold text-slate-300 border border-slate-600 font-sans";
      } else {
        if (na) na.className = "px-4 py-2 bg-blue-600 rounded-lg font-bold shadow-md text-white border border-blue-400 font-sans";
        if (ns) ns.className = "px-4 py-2 bg-slate-700 rounded-lg font-bold text-slate-300 border border-slate-600 font-sans";
      }
    }

    function fetchHistoryByDate(isAutoLoadToday = false) {
      const storeName = document.getElementById('storeName').value;
      if (!storeName) return;
      const isFactory = storeName === "工場事務所";
      const dateVal = document.getElementById('searchDate').value;
      const targetDate = isAutoLoadToday ? new Date() : new Date(dateVal);
      setInnerTextSafe('display-status-type', isAutoLoadToday ? "本日の送信済み内容" : `${targetDate.toLocaleDateString()} の内容`);
      setInnerTextSafe('store-status-badge', '検索中...');

      google.script.run.withSuccessHandler(function(data) {
        if (!data || !data.rows) return;
        const result = data.rows.find(row => isSameDate(row[0], targetDate) && String(row[1]) === storeName);
        const badge = document.getElementById('store-status-badge');
        const content = document.getElementById('store-sent-content');
        const details = document.getElementById('store-sent-details');
        
        if (result) {
          const bSub = cleanNum(result[3])*5000 + cleanNum(result[4])*1000;
          
          // 工場はすでに枚数で格納されているため、*50は不要。
          const cSub = isFactory 
            ? (cleanNum(result[5])*500 + cleanNum(result[6])*100 + cleanNum(result[7])*50 + cleanNum(result[8])*10 + cleanNum(result[9])*5 + cleanNum(result[10])*1)
            : (cleanNum(result[5])*25000 + cleanNum(result[6])*5000 + cleanNum(result[7])*2500 + cleanNum(result[8])*500 + cleanNum(result[9])*250 + cleanNum(result[10])*50);

          const displayTotalAmt = bSub + cSub;
          
          badge.className = "text-[10px] px-3 py-1 rounded-full font-black " + (displayTotalAmt === 0 ? "bg-slate-500 text-white" : "bg-blue-600 text-white");
          badge.innerText = displayTotalAmt === 0 ? "依頼なし報告済" : "送信済み";
          content.classList.add('hidden'); details.classList.remove('hidden');
          setInnerTextSafe('sent-time', new Date(result[0]).toLocaleTimeString('ja-JP', {hour:'2-digit', minute:'2-digit'}));
          
          const normalSumArea = document.getElementById('sent-store-normal-sum');
          const factorySumArea = document.getElementById('sent-factory-detailed-sum');

          if (isFactory) {
            if (normalSumArea) normalSumArea.classList.add('hidden');
            if (factorySumArea) {
              factorySumArea.classList.remove('hidden');
              setInnerTextSafe('sent-factory-paper-val', '¥ ' + bSub.toLocaleString());
              setInnerTextSafe('sent-factory-coin-val', '¥ ' + cSub.toLocaleString());
              setInnerTextSafe('sent-factory-grand-val', '¥ ' + displayTotalAmt.toLocaleString());
            }
          } else {
            if (factorySumArea) factorySumArea.classList.add('hidden');
            if (normalSumArea) {
              normalSumArea.classList.remove('hidden');
              setInnerTextSafe('sent-total', '¥ ' + displayTotalAmt.toLocaleString());
            }
          }
          
          setInnerTextSafe('sent-staff-name-display', "担当：" + (result[2] || "---"));
          
          const sentHeaderAmount = document.getElementById('sent-header-amount');
          if (sentHeaderAmount) {
            sentHeaderAmount.innerText = "金額";
          }

          let items = [];
          if (isFactory) {
            // 工場は「枚数表記（枚）」で、スプレッドシートの値がすでに枚数なのでそのまま表示する（*50は不要）
            items = [
              {n:'5,000円札', q:result[3], u:'枚', val: cleanNum(result[3])*5000},
              {n:'1,000円札', q:result[4], u:'枚', val: cleanNum(result[4])*1000},
              {n:'500円硬貨', q:cleanNum(result[5]), u:'枚', val: cleanNum(result[5])*500},
              {n:'100円硬貨', q:cleanNum(result[6]), u:'枚', val: cleanNum(result[6])*100},
              {n:'50円硬貨', q:cleanNum(result[7]), u:'枚', val: cleanNum(result[7])*50},
              {n:'10円硬貨', q:cleanNum(result[8]), u:'枚', val: cleanNum(result[8])*10},
              {n:'5円硬貨', q:cleanNum(result[9]), u:'枚', val: cleanNum(result[9])*5},
              {n:'1円硬貨', q:cleanNum(result[10]), u:'枚', val: cleanNum(result[10])*1}
            ];
          } else {
            items = [
              {n:'5,000円札', q:result[3], u:'枚', val: cleanNum(result[3])*5000},
              {n:'1,000円札', q:result[4], u:'枚', val: cleanNum(result[4])*1000},
              {n:'500円棒金', q:result[5], u:'本', val: cleanNum(result[5])*25000},
              {n:'100円棒金', q:result[6], u:'本', val: cleanNum(result[6])*5000},
              {n:'50円棒金', q:result[7], u:'本', val: cleanNum(result[7])*2500},
              {n:'10円棒金', q:result[8], u:'本', val: cleanNum(result[8])*500},
              {n:'5円棒金', q:result[9], u:'本', val: cleanNum(result[9])*250},
              {n:'1円棒金', q:result[10], u:'本', val: cleanNum(result[10])*50}
            ];
          }

          document.getElementById('sent-breakdown-body').innerHTML = items.filter(i => cleanNum(i.q) > 0).map(i => `
            <tr class="border-b text-black">
              <td class="py-2 pl-4 text-left font-bold text-slate-500">${i.n}</td>
              <td class="py-2 font-black">${i.q}${i.u}</td>
              <td class="py-2 pr-4 text-right text-blue-900 font-black font-mono">¥${i.val.toLocaleString()}</td>
            </tr>
          `).join('');
          
          document.getElementById('btn-print-self').onclick = () => { globalDataRows = data.rows; printSingleSlip(data.rows.indexOf(result)); };
        } else {
          badge.innerText = '未提出'; badge.className = "text-[10px] bg-slate-200 px-3 py-1 rounded-full text-slate-500 font-black";
          content.classList.remove('hidden'); details.classList.add('hidden');
        }
      }).getAdminData();
    }

    function fetchCurrentStoreRequest() { fetchHistoryByDate(true); }

    function submitForm(isZeroReport) {
      const store = document.getElementById('storeName').value;
      const staff = document.getElementById('staffName').value;
      if (!staff) { showModal('担当者を選択してください。'); return; }
      
      const total = isZeroReport ? 0 : calculateTotal(); // calculateTotalは店舗毎に自動判別
      const hasCoins = cleanNum(document.getElementById('coin500').value) + cleanNum(document.getElementById('coin100').value) + cleanNum(document.getElementById('coin50').value) + cleanNum(document.getElementById('coin10').value) + cleanNum(document.getElementById('coin5').value) + cleanNum(document.getElementById('coin1').value) > 0;
      
      if (!isZeroReport && total === 0 && !hasCoins) { showModal('数値を入力してください。'); return; }

      const data = { 
        storeName: store, staffName: staff, 
        bill5000: isZeroReport?0:cleanNum(document.getElementById('bill5000').value), 
        bill1000: isZeroReport?0:cleanNum(document.getElementById('bill1000').value), 
        coin500: isZeroReport?0:cleanNum(document.getElementById('coin500').value), 
        coin100: isZeroReport?0:cleanNum(document.getElementById('coin100').value), 
        coin50: isZeroReport?0:cleanNum(document.getElementById('coin50').value), 
        coin10: isZeroReport?0:cleanNum(document.getElementById('coin10').value), 
        coin5: isZeroReport?0:cleanNum(document.getElementById('coin5').value), 
        coin1: isZeroReport?0:cleanNum(document.getElementById('coin1').value), 
        totalAmount: total 
      };
      google.script.run.withSuccessHandler(() => { showModal('送信完了'); fetchCurrentStoreRequest(); }).submitExchangeRequest(data);
    }

    function loadAdminData() {
      switchView('admin');
      document.getElementById('admin-body').innerHTML = '<tr><td colspan="13" class="p-10 text-center animate-pulse">データを集計中...</td></tr>';
      google.script.run.withSuccessHandler(function(data) {
        if (!data || data.error) return;
        globalDataRows = data.rows || [];
        todayRecords = [];
        
        let totalsStore = { b5000: 0, b1000: 0, c500: 0, c100: 0, c50: 0, c10: 0, c5: 0, c1: 0, grand: 0, paper:0, coin:0, count: 0 };
        let totalsFactory = { b5000: 0, b1000: 0, c500: 0, c100: 0, c50: 0, c10: 0, c5: 0, c1: 0, grand: 0, paper:0, coin:0, submitted: false };
        let todayStoresMap = {}; 
        
        if (data.headers) document.getElementById('admin-head').innerHTML = data.headers.map(h => `<th class="p-2 border text-[9px] uppercase">${h}</th>`).join('') + '<th class="p-2 border text-[9px]">操作</th>';
        
        const rowObjs = globalDataRows.map((row, idx) => ({ row: row, originalIdx: idx }));
        
        document.getElementById('admin-body').innerHTML = rowObjs.slice().reverse().map(item => {
          const r = item.row;
          const isT = isSameDate(r[0], new Date());
          
          if (isT && !todayStoresMap[r[1]]) {
            const paperSum = cleanNum(r[3])*5000 + cleanNum(r[4])*1000;
            const coinSum = cleanNum(r[5])*25000 + cleanNum(r[6])*5000 + cleanNum(r[7])*2500 + cleanNum(r[8])*500 + cleanNum(r[9])*250 + cleanNum(r[10])*50;
            
            todayStoresMap[r[1]] = { idx: item.originalIdx };
            
            if (r[1] === "工場事務所") {
              // 工場はすでに枚数で保存されているため、直接単価を掛けて金額を算出する
              const factoryCoinAmtCalculated = cleanNum(r[5])*500 + cleanNum(r[6])*100 + cleanNum(r[7])*50 + cleanNum(r[8])*10 + cleanNum(r[9])*5 + cleanNum(r[10])*1;
              todayStoresMap[r[1]].amount = paperSum + factoryCoinAmtCalculated;
              totalsFactory.b5000 += cleanNum(r[3]);
              totalsFactory.b1000 += cleanNum(r[4]);
              totalsFactory.paper += paperSum;
              
              // 工場はすでに枚数なので、そのまま加算する（*50は不要）
              totalsFactory.c500 += cleanNum(r[5]);
              totalsFactory.c100 += cleanNum(r[6]);
              totalsFactory.c50 += cleanNum(r[7]);
              totalsFactory.c10 += cleanNum(r[8]);
              totalsFactory.c5 += cleanNum(r[9]);
              totalsFactory.c1 += cleanNum(r[10]);
              
              totalsFactory.coin += factoryCoinAmtCalculated;
              totalsFactory.grand += (paperSum + factoryCoinAmtCalculated);
              totalsFactory.submitted = true;
            } else {
              todayStoresMap[r[1]].amount = paperSum + coinSum; // 一般店舗は全合算
              totalsStore.b5000 += cleanNum(r[3]);
              totalsStore.b1000 += cleanNum(r[4]);
              totalsStore.paper += paperSum;
              // 一般店舗は本数のままカウント
              totalsStore.c500 += cleanNum(r[5]);
              totalsStore.c100 += cleanNum(r[6]);
              totalsStore.c50 += cleanNum(r[7]);
              totalsStore.c10 += cleanNum(r[8]);
              totalsStore.c5 += cleanNum(r[9]);
              totalsStore.c1 += cleanNum(r[10]);
              totalsStore.coin += coinSum;
              totalsStore.grand += (paperSum + coinSum);
              totalsStore.count++;
            }
            
            if (paperSum > 0 || coinSum > 0 || cleanNum(r[11]) > 0) {
              todayRecords.push({ row: r, idx: item.originalIdx });
            }
          }
          return `<tr class="border-b ${isT?'bg-yellow-50 text-black':'text-slate-400 opacity-60'}">
            ${r.map((c, i) => `<td class="p-1.5 border whitespace-nowrap ${typeof c==='number'?'text-right':''}">${i===0?new Date(c).toLocaleString():c}</td>`).join('')}
            <td class="p-1 border text-center"><button onclick="printSingleSlip(${item.originalIdx})" class="bg-blue-600 text-white px-2 py-0.5 rounded text-[9px]">印刷</button></td>
          </tr>`;
        }).join('');

        const grid = document.getElementById('admin-store-status-grid');
        grid.innerHTML = '';
        const activeStores = masterStores.length > 0 ? masterStores : Object.keys(todayStoresMap);
        
        activeStores.forEach(name => {
          const entry = todayStoresMap[name];
          const card = document.createElement('div');
          
          if (entry && entry.amount === 0 && globalDataRows[entry.idx][5] == 0) {
            card.className = "p-2 rounded-xl border bg-slate-100 opacity-70 h-24 grayscale";
            card.innerHTML = `<div class="flex justify-between text-xs font-bold"><span>${name}</span><span class="bg-slate-400 text-white px-1 rounded">無</span></div><div class="text-[9px] mt-4 font-bold text-slate-400">依頼なし報告済</div>`;
          } else if (entry) {
            const isFact = name === "工場事務所";
            card.className = isFact 
              ? "p-2 rounded-xl border-2 border-emerald-500 bg-emerald-50 h-24 shadow-md text-black"
              : "p-2 rounded-xl border-2 border-blue-500 bg-white h-24 shadow-md text-black";
              
            card.innerHTML = `
              <div class="flex justify-between text-xs font-bold">
                <span>${name}</span>
                <span class="${isFact ? 'bg-emerald-600' : 'bg-blue-600'} text-white px-1 rounded font-bold">済</span>
              </div>
              <div class="text-right mt-2">
                <span class="text-slate-700 font-bold text-xs">合計:¥${entry.amount.toLocaleString()}</span>
                <button onclick="printSingleSlip(${entry.idx})" class="block w-full mt-1 bg-slate-800 text-white text-[8px] rounded py-1">印刷</button>
              </div>`;
          } else {
            card.className = "p-2 rounded-xl border border-dashed bg-slate-50 opacity-40 h-24 grayscale";
            card.innerHTML = `<div class="text-xs font-bold text-slate-400">${name}</div><div class="text-center mt-4 text-xs font-bold">未提出</div>`;
          }
          grid.appendChild(card);
        });

        // 印刷用データの保持に代入：全体の合計（grand）から工場事務所（紙幣も硬貨もすべて）を完全に抜く
        currentSummaryTotals = {
          store: totalsStore,
          factory: totalsFactory,
          grand: totalsStore.grand // 工場分を完全に抜いた一般店舗のみの合計に更新
        };

        // 集計カード① 店舗分のみ（工場事務所除く）
        const storeCoinsTotal = totalsStore.c500 + totalsStore.c100 + totalsStore.c50 + totalsStore.c10 + totalsStore.c5 + totalsStore.c1;
        setInnerTextSafe('sum-store-bills', '¥' + totalsStore.grand.toLocaleString());
        setInnerTextSafe('sum-store-coins', storeCoinsTotal.toLocaleString() + '本');
        setInnerTextSafe('sum-store-count', totalsStore.count + ' / ' + activeStores.filter(name => name !== "工場事務所").length + ' 店');
        setInnerTextSafe('sum-store-5000', totalsStore.b5000.toLocaleString());
        setInnerTextSafe('sum-store-1000', totalsStore.b1000.toLocaleString());

        // 集計カード② 工場事務所のみ（紙幣・硬貨・紙幣硬貨合計を別々に出力）
        setInnerTextSafe('sum-factory-bills', '¥' + totalsFactory.paper.toLocaleString());
        setInnerTextSafe('sum-factory-coin-amt', '¥' + totalsFactory.coin.toLocaleString());
        setInnerTextSafe('sum-factory-total-amt', '¥' + totalsFactory.grand.toLocaleString());
        
        const factoryCoinsTotal = totalsFactory.c500 + totalsFactory.c100 + totalsFactory.c50 + totalsFactory.c10 + totalsFactory.c5 + totalsFactory.c1;
        setInnerTextSafe('sum-factory-coins', factoryCoinsTotal.toLocaleString() + '枚');
        setInnerTextSafe('sum-factory-status', totalsFactory.submitted ? "提出済" : "未提出");
        const facBadge = document.getElementById('sum-factory-status');
        if (facBadge) {
          facBadge.className = totalsFactory.submitted 
            ? "bg-emerald-600 text-white px-2 py-0.5 rounded text-xs font-bold" 
            : "bg-slate-200 text-slate-600 px-2 py-0.5 rounded text-xs font-bold";
        }
        setInnerTextSafe('sum-factory-5000', totalsFactory.b5000.toLocaleString());
        setInnerTextSafe('sum-factory-1000', totalsFactory.b1000.toLocaleString());

        // 集計カード③ 総合合計（工場事務所を紙幣・硬貨ともにすべて抜いた店舗分のみの合計）
        setInnerTextSafe('sum-grand-total', '¥ ' + totalsStore.grand.toLocaleString());
        setInnerTextSafe('sum-total-coins-count', '店舗: ' + storeCoinsTotal.toLocaleString() + '本 (工場分は含まれません)');

        // ヘッダー提出統計
        setInnerTextSafe('sum-submitted-count', Object.keys(todayStoresMap).length);
        setInnerTextSafe('sum-all-stores-count', activeStores.length);
      }).getAdminData();
    }

    function printSingleSlip(index) {
      const row = globalDataRows[index];
      if (row) { document.getElementById('print-area').innerHTML = generateSlipHTML(row); window.print(); }
    }

    function bulkPrintSlips() {
      if (todayRecords.length === 0) return;
      let html = '';
      for (let i = 0; i < todayRecords.length; i += 2) {
        html += '<div class="bulk-grid">' + generateSlipHTML(todayRecords[i].row);
        if (i + 1 < todayRecords.length) html += generateSlipHTML(todayRecords[i+1].row);
        else html += '<div class="print-section opacity-0"></div>';
        html += '</div>';
        if (i + 2 < todayRecords.length) html += '<div class="page-break"></div>';
      }
      document.getElementById('print-area').innerHTML = html; window.print();
    }

    function printSummary() {
      document.getElementById('print-area').innerHTML = generateSummaryHTML(currentSummaryTotals);
      window.print();
    }

    /**
     * 各店舗用の個別印刷内訳票：
     * 「工場事務所」は枚数表記、合計は紙幣＋硬貨の合計を表示。
     * 「一般店舗」は本数表記、合計は紙幣＋硬貨の合計を表示。
     */
    function generateSlipHTML(row) {
      const isFactory = row[1] === "工場事務所";
      const bSub = cleanNum(row[3])*5000 + cleanNum(row[4])*1000;
      const d = new Date(row[0]);
      
      if (isFactory) {
        // 【工場事務所用の印刷フォーム】
        // すでに枚数なので *50 は不要
        const cItems = [
          {n:'500円',q:cleanNum(row[5]), r:500},
          {n:'100円',q:cleanNum(row[6]), r:100},
          {n:'50円',q:cleanNum(row[7]), r:50},
          {n:'10円',q:cleanNum(row[8]), r:10},
          {n:'5円',q:cleanNum(row[9]), r:5},
          {n:'1円',q:cleanNum(row[10]), r:1}
        ];
        const cSub = cItems.reduce((s,i)=>s+i.q*i.r, 0);
        const total = bSub + cSub;
        return `<div class="print-section text-black">
          <div class="text-center border-b-2 border-black pb-2 mb-2">
            <h2 class="text-2xl font-black">両替金 内訳票</h2>
            <div class="flex justify-between items-end mt-2 text-xs">
              <div class="text-left">${d.toLocaleDateString('ja-JP')} ${d.getHours()}:${String(d.getMinutes()).padStart(2,'0')}<br><span class="text-xl underline font-black">${row[1]}</span></div>
              <div class="border-2 border-black px-2 py-1 font-bold">担当：${row[2]}</div>
            </div>
          </div>
          <table class="text-xs">
            <thead><tr class="bg-gray-100"><th class="text-black font-bold">種別・金種</th><th class="text-black font-bold">数量</th><th class="text-black font-bold">金額</th></tr></thead>
            <tbody>
              ${cleanNum(row[3])>0?`<tr><td>5,000円札</td><td class="text-center">${row[3]}枚</td><td class="text-right">¥${(row[3]*5000).toLocaleString()}</td></tr>`:''}
              ${cleanNum(row[4])>0?`<tr><td>1,000円札</td><td class="text-center">${row[4]}枚</td><td class="text-right">¥${(row[4]*1000).toLocaleString()}</td></tr>`:''}
              <tr class="print-highlight"><td class="text-left font-black">紙幣 小計</td><td colspan="2" class="text-right font-black">¥${bSub.toLocaleString()}</td></tr>
              ${cItems.filter(i=>cleanNum(i.q)>0).map(i=>`<tr><td>硬貨 ${i.n}</td><td class="text-center">${i.q}枚</td><td class="text-right">¥${(i.q*i.r).toLocaleString()}</td></tr>`).join('')}
              <tr class="print-highlight"><td class="text-left font-black">硬貨 小計</td><td colspan="2" class="text-right font-black">¥${cSub.toLocaleString()}</td></tr>
            </tbody>
            <tfoot><tr class="print-grand-total"><td colspan="2" class="text-center font-black">総合合計 (紙幣+硬貨)</td><td class="text-right font-black">¥${total.toLocaleString()}</td></tr></tfoot>
          </table>
        </div>`;
      } else {
        // 【一般店舗用の印刷フォーム】
        const cItems = [
          {n:'500円棒金',q:cleanNum(row[5]),r:25000},
          {n:'100円棒金',q:cleanNum(row[6]),r:5000},
          {n:'50円棒金',q:cleanNum(row[7]),r:2500},
          {n:'10円棒金',q:cleanNum(row[8]),r:500},
          {n:'5円棒金',q:cleanNum(row[9]),r:250},
          {n:'1円棒金',q:cleanNum(row[10]),r:50}
        ];
        const coinSub = cItems.reduce((s,i)=>s+cleanNum(i.q)*i.r, 0);
        const total = bSub + coinSub;
        return `<div class="print-section text-black">
          <div class="text-center border-b-2 border-black pb-2 mb-2">
            <h2 class="text-2xl font-black">両替金 内訳票</h2>
            <div class="flex justify-between items-end mt-2 text-xs">
              <div class="text-left">${d.toLocaleDateString('ja-JP')} ${d.getHours()}:${String(d.getMinutes()).padStart(2,'0')}<br><span class="text-xl underline font-black">${row[1]}</span></div>
              <div class="border-2 border-black px-2 py-1 font-bold">担当：${row[2]}</div>
            </div>
          </div>
          <table class="text-xs">
            <thead><tr class="bg-gray-100"><th class="text-black font-bold">種別・金種</th><th class="text-black font-bold">数量</th><th class="text-black font-bold">金額</th></tr></thead>
            <tbody>
              ${cleanNum(row[3])>0?`<tr><td>5,000円札</td><td class="text-center">${row[3]}枚</td><td class="text-right">¥${(row[3]*5000).toLocaleString()}</td></tr>`:''}
              ${cleanNum(row[4])>0?`<tr><td>1,000円札</td><td class="text-center">${row[4]}枚</td><td class="text-right">¥${(row[4]*1000).toLocaleString()}</td></tr>`:''}
              <tr class="print-highlight"><td class="text-left font-black">紙幣 小計</td><td colspan="2" class="text-right font-black">¥${bSub.toLocaleString()}</td></tr>
              ${cItems.filter(i=>cleanNum(i.q)>0).map(i=>`<tr><td>${i.n}</td><td class="text-center">${i.q}本</td><td class="text-right">¥${(i.q*i.r).toLocaleString()}</td></tr>`).join('')}
              <tr class="print-highlight"><td class="text-left font-black">棒金 小計</td><td colspan="2" class="text-right font-black">¥${coinSub.toLocaleString()}</td></tr>
            </tbody>
            <tfoot><tr class="print-grand-total"><td colspan="2" class="text-center font-black">総合合計 (紙幣+硬貨)</td><td class="text-right font-black">¥${total.toLocaleString()}</tfoot>
          </table>
        </div>`;
      }
    }

    /**
     * 工場事務所：全体集計表のレイアウト生成
     * ※一般店舗合計を左側に、工場事務所合計を右側に左右分割（グリッド表示）
     * それぞれ金種別に表示し、「紙幣小計」「硬貨小計」「合計」を設定。
     * 特に紙幣小計（および他の小計ライン）を太字で強調。
     */
    function generateSummaryHTML(t) {
      const storeVal = t.store || { b5000:0, b1000:0, c500:0, c100:0, c50:0, c10:0, c5:0, c1:0, grand:0, paper:0, coin:0 };
      const factVal = t.factory || { b5000:0, b1000:0, c500:0, c100:0, c50:0, c10:0, c5:0, c1:0, grand:0, paper:0, coin:0 };
      
      const storeCoinsTotal = storeVal.c500 + storeVal.c100 + storeVal.c50 + storeVal.c10 + storeVal.c5 + storeVal.c1;
      const factCoinsTotal = factVal.c500 + factVal.c100 + factVal.c50 + factVal.c10 + factVal.c5 + factVal.c1;

      return `<div class="summary-print-section text-black">
        <div class="text-center border-b-2 border-black pb-2 mb-3">
          <h2 class="text-2xl font-black uppercase">本日 両替集計表</h2>
          <div class="flex justify-between mt-2 text-xs font-bold text-black">
            <span>${new Date().toLocaleDateString('ja-JP')}</span>
            <span>本店事務所 集計控え</span>
          </div>
        </div>
        
        <div class="summary-grid">
          <!-- 【左列：一般店舗合計 (工場事務所除く)】 -->
          <div>
            <h3 class="bg-blue-600 text-white p-1 text-xs font-bold mb-2 uppercase text-center rounded">【 店舗合計（工場事務所除く） 】</h3>
            <table class="text-xs text-black">
              <thead>
