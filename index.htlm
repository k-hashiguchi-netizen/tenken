                </tr>
                <tr>
                  <td>500円硬貨</td>
                  <td class="text-center font-mono">${factVal.c500.toLocaleString()} 枚</td>
                  <td class="text-right font-mono">¥${(factVal.c500 * 500).toLocaleString()}</td>
                </tr>
                <tr>
                  <td>100円硬貨</td>
